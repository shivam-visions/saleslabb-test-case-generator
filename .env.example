# test-case-generator — environment variables
#
# Copy this file to .env (in the same directory) and fill in real values.
# .env is gitignored. Never commit secrets.

# ───────────────────────────────────────────────────────────────────────────
# Atlassian Confluence — used by src/common/confluence_uploader.py
# ───────────────────────────────────────────────────────────────────────────

# Your Atlassian account email
ATLASSIAN_EMAIL=

# Atlassian API token. Create one at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=

# Expiry date for the Atlassian API token (ISO format: YYYY-MM-DD).
# The Confluence uploader checks this on every run and warns when expiry is
# within 30 days (and errors if the date has passed). Atlassian doesn't expose
# expiry dates via API, so you must record it here manually when creating the token.
ATLASSIAN_API_TOKEN_EXPIRES=

# ───────────────────────────────────────────────────────────────────────────
# Optional: override the Confluence base URL (default = vitavirtues)
# ───────────────────────────────────────────────────────────────────────────
# CONFLUENCE_BASE_URL=https://vitavirtues.atlassian.net/wiki
